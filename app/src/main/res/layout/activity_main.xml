<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dashboard -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧹 CleanDroid"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Armazenamento: …"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/storageBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:id="@+id/txtLastClean"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nenhuma limpeza ainda"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Verificando acesso..."
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Toque em Varrer agora para começar."
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🔍 Varrer agora"
                    android:textSize="16sp"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClean"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧺 Limpar selecionados"
                    app:cornerRadius="14dp"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Resultado por categoria -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resultado"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/categoryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- O que limpar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O que limpar"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="✅ Temporários e instaladores" />

                <CheckBox
                    android:id="@+id/cbOrganizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="✅ Pastas vazias, lixo oculto e restos" />

                <CheckBox
                    android:id="@+id/cbWhats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ WhatsApp selecionado" />

                <CheckBox
                    android:id="@+id/cbDownloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Downloads grandes e antigos" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ferramentas -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ferramentas"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <Button android:id="@+id/btnWhats" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="💬 WhatsApp" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnDuplicates" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="📑 Duplicados" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnLarge" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="📦 Arquivos grandes" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnDeep" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="🚀 Profunda" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnBattery" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="🔋 Bateria" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnDiag" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="🩺 Diagnóstico" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnReport" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="📄 Relatório" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnSchedule" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_gravity="fill" android:text="⏰ Agendar" style="?attr/materialButtonOutlinedStyle" />
                    <Button android:id="@+id/btnAllFiles" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_columnSpan="2" android:layout_gravity="fill" android:text="📁 Acesso total (Android 11+)" style="?attr/materialButtonOutlinedStyle" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
